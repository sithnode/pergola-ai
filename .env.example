# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
AGENT_PORT=8000
# Comma-separated list of allowed CORS origins (use * for development)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ── n8n Automation ─────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_WEBHOOK_URL=http://localhost:5678
# Webhook secret for securing n8n → agent calls
N8N_WEBHOOK_SECRET=change_this_secret

# ── Email Notifications (SendGrid) ─────────────────────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=sales@pergola-paradise.com
FROM_NAME=Pergola Paradise

# ── Supplier APIs ──────────────────────────────────────────────────────────────
SUPPLIER_WOODCRAFT_API_KEY=
SUPPLIER_WOODCRAFT_API_URL=https://api.woodcraftoutdoors.com/v1

SUPPLIER_METALWORKS_API_KEY=
SUPPLIER_METALWORKS_API_URL=https://api.metalworkspro.com/v1

SUPPLIER_VINYLOUTDOOR_API_KEY=
SUPPLIER_VINYLOUTDOOR_API_URL=https://api.vinyloutdoor.com/v1
